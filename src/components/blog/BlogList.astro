---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  initialCount?: number;
}

const { posts, initialCount = 20 } = Astro.props;

// Render only first N posts in HTML for better initial load
const initialPosts = posts.slice(0, initialCount);

function formatMonth(date: Date): string {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  return `${year}-${month}`;
}
---

<div class="blog-posts-wrapper">
<div id="blog-posts-container" class="space-y-8">
  {initialPosts.map((post) => {
    const formattedDate = new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(post.data.pubDate);

    const tags = post.data.tags || [];
    const tagsString = tags.join(',');
    const monthString = formatMonth(post.data.pubDate);

    return (
      <article
        class="blog-card blog-post-item"
        data-tags={tagsString}
        data-month={monthString}
        data-title={post.data.title.toLowerCase()}
        data-description={post.data.description.toLowerCase()}
        data-slug={post.slug}
      >
        <a href={`/blog/${post.slug}`} class="block group">
          <h2 class="text-xl font-bold mb-2 text-gray-900 dark:text-white group-hover:text-teal-700 dark:group-hover:text-teal-400 transition-colors">
            {post.data.title}
          </h2>

          <div class="flex flex-wrap items-center gap-3 text-sm text-gray-600 dark:text-gray-400 mb-3">
            <time datetime={post.data.pubDate.toISOString()} class="blog-date">
              {formattedDate}
            </time>
            <span>{post.data.author}</span>
          </div>

          <p class="text-gray-700 dark:text-gray-300 mb-4">
            {post.data.description}
          </p>

          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="blog-tag">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      </article>
    );
  })}
</div>

<!-- Show More Button -->
<div id="show-more-container" class="hidden text-center mt-8">
  <button
    id="show-more-btn"
    class="px-6 py-3 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors font-medium"
  >
    Show More Posts
  </button>
  <p id="pagination-info" class="text-sm text-gray-600 dark:text-gray-400 mt-2">
    <!-- Showing X of Y posts -->
  </p>
</div>

<!-- No Results Message -->
<div id="no-results" class="hidden text-center py-12">
  <p class="text-gray-600 dark:text-gray-400 mb-4">
    No posts found matching your filters.
  </p>
  <button
    id="clear-filters-no-results"
    class="px-4 py-2 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors"
  >
    Clear All Filters
  </button>
</div>
</div>
