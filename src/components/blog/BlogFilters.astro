---
interface TagWithCount {
  value: string;
  count: number;
}

interface MonthWithCount {
  value: string;
  count: number;
}

interface Props {
  allTags: TagWithCount[];
  allMonths: MonthWithCount[];
  totalPosts: number;
}

const { allTags, allMonths, totalPosts } = Astro.props;

// Show first 10 tags initially
const INITIAL_TAGS_DISPLAY = 10;

function formatMonthLabel(monthString: string): string {
  const [year, month] = monthString.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1, 1);
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
  }).format(date);
}
---

<div class="filter-container mb-8">
  <div class="filter-header mb-6">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Blog Posts</h2>
    <p id="results-count" class="text-sm text-gray-600 dark:text-gray-400">
      Showing {totalPosts} of {totalPosts} posts
    </p>
  </div>

  <div class="filter-sidebar-wrapper">
    <div class="filter-sidebar">
      <!-- Search Input -->
      <div class="filter-section">
        <label for="search-input" class="filter-label">
          Search
        </label>
        <div class="search-input-wrapper">
          <svg
            class="search-icon"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <input
            type="text"
            id="search-input"
            placeholder="Search posts..."
            class="search-input"
          />
          <button
            id="clear-search"
            class="clear-search-btn hidden"
            aria-label="Clear search"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>

      <!-- Tags Filter -->
      {allTags.length > 0 && (
        <div class="filter-section">
          <label class="filter-label">
            Tags
          </label>
          <div class="tag-filter-container">
            {allTags.slice(0, INITIAL_TAGS_DISPLAY).map((tag) => (
              <button
                class="tag-filter-btn"
                data-tag={tag.value}
                aria-pressed="false"
              >
                <span class="tag-name">{tag.value}</span>
                <span class="tag-count">{tag.count}</span>
              </button>
            ))}
          </div>
          {allTags.length > INITIAL_TAGS_DISPLAY && (
            <div>
              <button
                id="load-more-tags"
                class="load-more-btn"
                data-total-tags={allTags.length}
              >
                Load more ({allTags.length - INITIAL_TAGS_DISPLAY} more)
              </button>
              <div id="hidden-tags" class="hidden">
                {allTags.slice(INITIAL_TAGS_DISPLAY).map((tag) => (
                  <button
                    class="tag-filter-btn"
                    data-tag={tag.value}
                    aria-pressed="false"
                  >
                    <span class="tag-name">{tag.value}</span>
                    <span class="tag-count">{tag.count}</span>
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      <!-- Month Filter -->
      {allMonths.length > 0 && (
        <div class="filter-section">
          <label class="filter-label">
            Archive
          </label>
          <div class="month-filter-list">
            <button
              class="month-filter-item"
              data-month=""
              aria-pressed="false"
            >
              <span class="month-filter-label">All months</span>
              <span class="month-filter-count">{totalPosts}</span>
            </button>
            {allMonths.map((month) => (
              <button
                class="month-filter-item"
                data-month={month.value}
                aria-pressed="false"
              >
                <span class="month-filter-label">{formatMonthLabel(month.value)}</span>
                <span class="month-filter-count">{month.count}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Active Filters -->
      <div id="active-filters-section" class="filter-section hidden">
        <div class="flex justify-between items-center mb-2">
          <span class="filter-label">Active Filters</span>
          <button
            id="clear-all-filters"
            class="text-xs text-teal-600 dark:text-teal-400 hover:text-teal-700 dark:hover:text-teal-300 font-medium"
          >
            Clear all
          </button>
        </div>
        <div id="active-filters-list" class="flex flex-wrap gap-2">
          <!-- Active filter pills will be added here dynamically -->
        </div>
      </div>
    </div>
  </div>
</div>

<noscript>
  <div class="p-4 mb-6 bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg">
    <p class="text-sm text-yellow-800 dark:text-yellow-200">
      JavaScript is required for filtering. All posts are shown below.
    </p>
  </div>
</noscript>
