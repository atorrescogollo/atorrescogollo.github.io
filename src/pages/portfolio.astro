---
import '../styles/global.css';
import { getEntry } from 'astro:content';

const resumeEntry = await getEntry('resume', 'resume');
if (!resumeEntry) {
  throw new Error('Resume not found');
}

const { Content: ResumeContent } = await resumeEntry.render();
const { name, title, email, phone, linkedin, github, pdf } = resumeEntry.data;

const description = `Professional portfolio of ${name} - ${title}. DevOps Engineer specializing in Infrastructure as Code, cloud infrastructure, and automation.`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultImage = new URL('/favicon.svg', Astro.site).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Álvaro Torres Cogollo | Blog" href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`Portfolio - ${name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={defaultImage} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={`Portfolio - ${name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={defaultImage} />

    <title>Portfolio - {name}</title>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 antialiased">
    <nav class="border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-800 print:hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-14">
          <a href="/" class="flex items-center hover:opacity-80 transition-opacity" aria-label="Home">
            <img src="/favicon.svg" alt="" class="w-8 h-8" />
          </a>
          <div class="flex gap-6">
            <a href="/portfolio" class="flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-teal-600 dark:hover:text-teal-500 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Portfolio
            </a>
            <a href="/blog" class="flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-teal-600 dark:hover:text-teal-500 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
              Blog
            </a>
          </div>
        </div>
      </div>
    </nav>
    <main class="min-h-screen py-4 sm:py-6 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white dark:bg-gray-800 shadow-sm rounded-lg overflow-hidden">
        <!-- Header Section -->
        <header class="px-4 sm:px-6 py-6 sm:py-8 border-b border-gray-200 dark:border-gray-700 print:border-gray-300">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 mb-4 sm:mb-6">
            <div>
              <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold mb-1 sm:mb-2 text-gray-800 dark:text-gray-200">{name}</h1>
              <p class="text-sm sm:text-base lg:text-lg text-gray-500 dark:text-gray-500">{title}</p>
            </div>
            <a
              href={pdf}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2 bg-teal-600 dark:bg-teal-700 text-white rounded-lg hover:bg-teal-700 dark:hover:bg-teal-600 transition-colors print:hidden"
              aria-label="View PDF Resume"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span class="font-medium">PDF</span>
            </a>
          </div>

          <div class="text-xs sm:text-sm text-gray-500 dark:text-gray-500">
            <div class="flex flex-col sm:flex-row sm:flex-wrap gap-y-1 sm:gap-y-2 sm:gap-x-4">
              <a href={`mailto:${email}`} class="flex items-center gap-1.5 hover:text-teal-600 dark:hover:text-teal-500 transition-colors">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                {email}
              </a>
              <span class="hidden sm:inline text-gray-400 dark:text-gray-600">•</span>
              <a href={`tel:${phone}`} class="flex items-center gap-1.5 hover:text-teal-600 dark:hover:text-teal-500 transition-colors">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                {phone}
              </a>
              <span class="hidden sm:inline text-gray-400 dark:text-gray-600">•</span>
              <a href={linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-teal-600 dark:hover:text-teal-500 transition-colors">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
              <span class="hidden sm:inline text-gray-400 dark:text-gray-600">•</span>
              <a href={github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 hover:text-teal-600 dark:hover:text-teal-500 transition-colors">
                <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                GitHub
              </a>
            </div>
          </div>
        </header>

        <!-- Resume Content -->
        <div class="px-4 sm:px-6 py-6 sm:py-8 prose prose-slate dark:prose-invert max-w-none resume-content">
          <ResumeContent />
        </div>
      </div>
    </main>
  </body>
</html>
